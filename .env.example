# Copy this file to ".env" (same folder as server.js) and fill it in.
# ".env" is git-ignored — never commit your real connection string.

# MongoDB connection string. Leave empty / delete the line to run without a database.
#   MongoDB Atlas (cloud):  mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/
#   Local MongoDB:          mongodb://127.0.0.1:27017
# Special characters in the password must be URL-encoded (e.g. "@" -> %40, "#" -> %23).
MONGODB_URI=

# Database name (optional, default: stocksense)
MONGODB_DB=stocksense

# How many days to keep the 5-minute scan snapshots (optional, default 30; 0 = keep forever).
# A scan is ~14 KB, i.e. ~1 MB per market per trading day. Best-of-the-best picks are tiny and kept forever.
SCAN_TTL_DAYS=30

# Most sync codes (people) this server accepts, so a public site cannot fill a free database (optional, default 20)
# SYNC_MAX_BUCKETS=20

# How long to wait for the database before giving up, in milliseconds (optional, default 5000)
# MONGODB_TIMEOUT_MS=5000

# Port for the web app (optional, default 3000). Set this if another app already uses 3000.
# PORT=3100

# ---- Daily Telegram digest (5 intraday + 5 long-term ideas) ----
# 1) Telegram -> @BotFather -> /newbot -> copy the token here.   2) Open your new bot, press Start, send "hi".
# 3) Run "npm run telegram:setup" - it finds your chat id (add --save to write it below for you).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Protects the scheduled endpoint. On Vercel set the same value as an environment variable: the scheduler
# sends it automatically. Make one with:  openssl rand -hex 24
CRON_SECRET=
# Markets to send (default IN; use "IN,US" for both) and the address of your deployed site (adds a link)
# DIGEST_MARKETS=IN
# APP_URL=https://stock-any-neon.vercel.app
